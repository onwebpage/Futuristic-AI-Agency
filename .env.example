PAYPAL_MODE=sandbox
# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration Template
# 
# Copy this file to .env and populate with real values for your environment.
# NEVER commit .env to version control. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
NODE_ENV=production
PORT=3000

# Security & Session Management
# REQUIRED in production. Generate strong random secrets for auth tokens.
SESSION_SECRET=your_secure_admin_session_secret_here_min_32_chars
USER_SESSION_SECRET=your_secure_user_session_secret_here_min_32_chars

# CORS Configuration
# Comma-separated list of allowed origins for API requests
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://partner.yourdomain.com

# PayPal Integration
# Get these from https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=production

# Supabase Database & Auth
# Get these from https://app.supabase.com/project/[project-id]/settings/api
# 
# IMPORTANT: Use the SERVICE_ROLE key (secret), NOT the anon/publishable key!
# The service_role key starts with "eyJ" and has full database access.
# The anon key starts with "eyJ" but has limited Row Level Security permissions.
#
# Option 1 (Recommended): Use SUPABASE_SECRET_KEY
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key_here
#
# Option 2 (Alternative): Use SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key_here
#
# Frontend/Public key (for client-side operations only, optional for backend):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key_here
#
# Access token for Supabase Management API (optional):
SUPABASE_ACCESS_TOKEN=your_access_token_here

# AI Chatbot Configuration
# Get your API key from https://platform.openai.com/api-keys
# Model options: gpt-4, gpt-3.5-turbo, gpt-4-turbo-preview
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Logging
LOG_LEVEL=info


